# Copy to .env. Generate both secrets before exposing the app.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEBUG=0
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
ALLOWED_HOSTS=localhost,127.0.0.1,api,mcp
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=0
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp:*
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MCP_RATE_LIMIT=60
MCP_CONCURRENCY=2
MCP_GLOBAL_CONCURRENCY=8

# Public test instance: disable self-service signup with 0.
ALLOW_REGISTRATION=1

# Exact CIDR of an upstream tunnel/proxy, e.g. 192.168.1.50/32.
# Incoming forwarded headers are trusted only from this address.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Hostnames served behind a TLS-terminating tunnel; space-separated.
# HTTP requests forwarded by that proxy redirect to HTTPS.
PUBLIC_HOSTS=localhost.invalid
